{
  "info": {
    "_postman_id": "2e542180-79f9-46c8-8e17-836c63f9baeb",
    "name": "wexchange API Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "17256075"
  },
  "item": [
    {
      "name": "Purchases",
      "item": [
        {
          "name": "Create Purchase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"purchase was created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"purchaseId\", body.id);",
                  "",
                  "const location = pm.response.headers.get(\"Location\");",
                  "pm.test(\"Location resolves to the canonical purchase resource\", function () {",
                  "    pm.expect(location).to.include(`/v1/purchases/${body.id}`);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"description\" : \"Test description\",\n    \"date\"  : \"2023-11-16\",\n    \"amount\" : 152.55\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "localhost:8080/v1/purchases",
              "host": [
                "localhost:8080"
              ],
              "path": [
                "v1",
                "purchases"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Purchase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the purchase created above is found\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "localhost:8080/v1/purchases/{{purchaseId}}",
              "host": [
                "localhost:8080"
              ],
              "path": [
                "v1",
                "purchases",
                "{{purchaseId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Convert Purchase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the purchase created above is converted\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "localhost:8080/v1/purchases/{{purchaseId}}/convert?country_currency=Brazil",
              "host": [
                "localhost:8080"
              ],
              "path": [
                "v1",
                "purchases",
                "{{purchaseId}}",
                "convert"
              ],
              "query": [
                {
                  "key": "country_currency",
                  "value": "Brazil",
                  "description": "Required: country currency case insensitive and like"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Country Currencies",
      "item": [
        {
          "name": "Retrieve Country Currency Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "localhost:8080/v1/country_currencies?country_currency=&page=0&size=20&sort=country,asc&offset=0",
              "host": [
                "localhost:8080"
              ],
              "path": [
                "v1",
                "country_currencies"
              ],
              "query": [
                {
                  "key": "country_currency",
                  "value": "",
                  "description": "country currency case insensitive and like"
                },
                {
                  "key": "page",
                  "value": "0",
                  "description": "Desired page"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Number of registers per page"
                },
                {
                  "key": "sort",
                  "value": "country,asc",
                  "description": "sorting: \"fieldName,sortOrder(asc,desc)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "offset size"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "purchaseId",
      "value": "",
      "description": "Set by the Create Purchase request's test script. Run the Purchases folder in order, or run Create Purchase once before Get/Convert."
    }
  ]
}
